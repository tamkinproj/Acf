# Foundation Management System
#
# You normally DO NOT create this file by hand: the setup wizard (/install) writes it for you.
# This template is for developers running the app without the wizard.

APP_NAME="Foundation Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Timestamps are stored in UTC. Do not change this; the display timezone is a setting inside the app.
APP_TIMEZONE=UTC

# The Foundation system has its OWN database. Never point this at another application's database.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/foundation.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=foundation_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Set by the installer. Its presence marks this environment as installed; do not edit or copy it.
# FOUNDATION_INSTALL_ID=

# Require the one-time installer token even for loopback requests (set true behind any reverse proxy).
# FOUNDATION_INSTALLER_REQUIRE_TOKEN=true
