{
  "manifest_version": 3,
  "name": "ACF to Dar Al Ber",
  "version": "1.2.0",
  "description": "Fills the Dar Al Ber orphan update form (4 steps) from your ACF system: names, family, guardian and the attachments.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "ACF to Dar Al Ber", "default_popup": "popup.html", "default_icon": "icons/48.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://alinsania.com/*", "https://www.alinsania.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    { "matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ]
}
