# alinsania.com (main site): send every address that does not exist to the home page.
# Put this file in public_html. Visitors never see Hostinger's 404, 403 or placeholder pages.

Options -Indexes
DirectoryIndex index.html index.php

# Safety net: any error page that still slips through shows the home page instead.
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Never touch SSL certificate checks.
RewriteRule ^\.well-known/ - [L]

# Old links from the Beta stage keep working: /Beta/anything -> /anything
RewriteRule ^Beta/?(.*)$ /$1 [R=301,L]

# Every rule below runs only once index.html exists, so there is no redirect loop.

# Hostinger's placeholder page.
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^default\.php$ / [R=302,L]

# A folder with no index file (would show "Forbidden").
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteRule ^. / [R=302,L]

# Any address that is not a real file or folder (would show "404 Not Found").
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ / [R=302,L]
</IfModule>

# The API in the "server" folder has its own .htaccess, so these rules do not apply inside it.
